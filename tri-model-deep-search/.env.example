# Tri-Model Deep Search - Environment Variables
# Copy this file to .env and fill in your API keys

# ==============================================
# OpenRouter API (for DeepSeek, ChatGPT, and Perplexity Search)
# ==============================================
# Get your API key from: https://openrouter.ai/keys
# This single key powers:
#   - DeepSeek (Stage 1)
#   - ChatGPT (Stage 3)
#   - Perplexity Search (for Stage 1 & 3)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Your site URL for OpenRouter ranking
# OPENROUTER_SITE_URL=https://your-site.com

# ==============================================
# Google Gemini API (with native Google Search)
# ==============================================
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================
# Architecture Overview
# ==============================================
#
# Stage 1 (DeepSeek via OpenRouter):
#   - Model: deepseek/deepseek-chat
#   - Search: Perplexity sonar (via OpenRouter)
#
# Stage 2 (Gemini via Google AI Studio):
#   - Model: gemini-2.0-flash
#   - Search: Native Google Search grounding (built-in!)
#
# Stage 3 (ChatGPT via OpenRouter):
#   - Model: openai/gpt-4-turbo
#   - Search: Perplexity sonar (via OpenRouter)
#
# ==============================================
# Only 2 API keys needed!
# ==============================================
