# Tri-Model Deep Search - Environment Variables
# Copy this file to .env and fill in your API keys

# ==============================================
# OpenRouter API (for DeepSeek and OpenAI/ChatGPT)
# ==============================================
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Your site URL for OpenRouter ranking
# OPENROUTER_SITE_URL=https://your-site.com

# ==============================================
# Google Gemini API (with native Google Search)
# ==============================================
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================
# Search API (Optional - for DeepSeek/OpenAI stages)
# ==============================================
# Default: DuckDuckGo (free, no API key needed)
# Alternative: Serper.dev - https://serper.dev/
# SEARCH_API_KEY=your_serper_api_key_here

# ==============================================
# Model Configuration Notes
# ==============================================
#
# Stage 1 (DeepSeek via OpenRouter):
#   - Model: deepseek/deepseek-chat
#   - Uses DuckDuckGo for search
#
# Stage 2 (Gemini via Google AI Studio):
#   - Model: gemini-2.0-flash (recommended)
#   - Uses native Google Search grounding (no extra config needed!)
#
# Stage 3 (ChatGPT via OpenRouter):
#   - Model: openai/gpt-4-turbo
#   - Uses DuckDuckGo for search
#
# ==============================================
